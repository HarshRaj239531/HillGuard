# ==============================================================================
# HillGuard Backend Environment Template (.env.example)
# ==============================================================================

PORT=3000
NODE_ENV=development

# Database Connection URL (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://hillguard:hillguard_secure_pwd@localhost:5432/hillguard_db

# PostgreSQL Credentials
POSTGRES_USER=hillguard
POSTGRES_PASSWORD=hillguard_secure_pwd
POSTGRES_DB=hillguard_db
POSTGRES_PORT=5432

# Local On-Device AI Engine (Google Gemma 4 / Local Inference)
LOCAL_GEMMA_ENABLED=true
GEMMA_MODEL=gemma-4-local
LOCAL_GEMMA_ENDPOINT=http://localhost:11434/api/generate
